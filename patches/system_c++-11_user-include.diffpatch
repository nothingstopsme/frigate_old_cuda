diff -aruN include/c++/11/bits/move.h include-patched/c++/11/bits/move.h
--- include/c++/11/bits/move.h	2023-02-16 08:55:10.000000000 +0000
+++ include-patched/c++/11/bits/move.h	2026-04-29 12:15:11.585934126 +0000
@@ -35,6 +35,10 @@
 # include <bits/concept_check.h>
 #endif
 
+#ifdef __CUDACC__
+#include <type_traits>
+#endif
+
 namespace std _GLIBCXX_VISIBILITY(default)
 {
 _GLIBCXX_BEGIN_NAMESPACE_VERSION
@@ -44,10 +48,26 @@
    *  @brief Same as C++11 std::addressof
    *  @ingroup utilities
    */
+#ifdef __CUDACC__
+# if __cplusplus >= 201703L
+#  error The workaround of "__addressof()" for old CUDA is not compatible with the c++17 standard
+# else
+  template<typename _Tp>
+    inline _GLIBCXX_CONSTEXPR typename enable_if<is_object<_Tp>::value, _Tp*>::type
+    __addressof(_Tp& __r) _GLIBCXX_NOEXCEPT
+    { return reinterpret_cast<_Tp*>(&const_cast<char&>(reinterpret_cast<const volatile char&>(__r))); }
+
+  template<typename _Tp>
+    inline _GLIBCXX_CONSTEXPR typename enable_if<!is_object<_Tp>::value, _Tp*>::type
+    __addressof(_Tp& __r) _GLIBCXX_NOEXCEPT
+    { return &__r; }
+# endif
+#else
   template<typename _Tp>
     inline _GLIBCXX_CONSTEXPR _Tp*
     __addressof(_Tp& __r) _GLIBCXX_NOEXCEPT
     { return __builtin_addressof(__r); }
+#endif
 
 #if __cplusplus >= 201103L
 
