diff -aruN include/c++/11/utility include-patched/c++/11/utility
--- include/c++/11/utility	2023-02-16 08:55:10.000000000 +0000
+++ include-patched/c++/11/utility	2026-04-29 12:15:56.328726176 +0000
@@ -293,10 +293,30 @@
 
 #endif // C++14
 
+#ifdef __CUDACC__
+  template<typename _Tp, _Tp... _Indexes>
+    struct _Indexes_extender
+    { typedef _Indexes_extender<_Tp, _Indexes..., _Tp(sizeof...(_Indexes))> __next; };
+            
+  template<typename _Tp, size_t _Num>
+    struct _Indexes_builder
+    { typedef typename _Indexes_builder<_Tp, _Num - 1>::type::__next type; };
+                          
+  template<typename _Tp>
+    struct _Indexes_builder<_Tp, 0>
+    { typedef _Indexes_extender<_Tp> type; };
+#endif
+
   // Stores a tuple of indices.  Used by tuple and pair, and by bind() to
   // extract the elements in a tuple.
   template<size_t... _Indexes> struct _Index_tuple { };
 
+#ifdef __CUDACC__
+  template<size_t... _Indexes>
+  constexpr _Index_tuple<_Indexes...> _get_tuple_from_extender(_Indexes_extender<size_t, _Indexes...>)
+  { return {}; }
+#endif
+
   // Builds an _Index_tuple<0, 1, 2, ..., _Num-1>.
   template<size_t _Num>
     struct _Build_index_tuple
@@ -308,8 +328,12 @@
       // Clang defines __make_integer_seq for this purpose.
       using __type = __make_integer_seq<_IdxTuple, size_t, _Num>;
 #else
+# ifdef __CUDACC__
+      using __type = decltype(_get_tuple_from_extender(typename _Indexes_builder<size_t, _Num>::type()));
+# else
       // For GCC and other compilers, use __integer_pack instead.
       using __type = _Index_tuple<__integer_pack(_Num)...>;
+# endif
 #endif
     };
 
@@ -325,13 +349,23 @@
       static constexpr size_t size() noexcept { return sizeof...(_Idx); }
     };
 
+#ifdef __CUDACC__
+  template<typename _Tp, _Tp... _Idx>
+  constexpr integer_sequence<_Tp, _Idx...> _get_sequence_from_extender(_Indexes_extender<_Tp, _Idx...>)
+  { return {}; }
+#endif
+
   /// Alias template make_integer_sequence
   template<typename _Tp, _Tp _Num>
     using make_integer_sequence
 #if __has_builtin(__make_integer_seq)
       = __make_integer_seq<integer_sequence, _Tp, _Num>;
 #else
+# ifdef __CUDACC__
+      = decltype(_get_sequence_from_extender(typename _Indexes_builder<_Tp, _Num>::type()));
+# else
       = integer_sequence<_Tp, __integer_pack(_Num)...>;
+# endif
 #endif
 
   /// Alias template index_sequence
