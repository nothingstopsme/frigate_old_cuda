     }
 
   template<typename _Key, typename _Val, typename _KeyOfValue,
@@ -2172,7 +2172,7 @@
 	{
 	  if (size() > 0
 	      && _M_impl._M_key_compare(_S_key(_M_rightmost()), __k))
