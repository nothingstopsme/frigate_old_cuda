diff -aruN include/x86_64-linux-gnu/c++/11/bits/c++config.h include-patched/x86_64-linux-gnu/c++/11/bits/c++config.h
--- include/x86_64-linux-gnu/c++/11/bits/c++config.h	2023-02-16 08:55:10.000000000 +0000
+++ include-patched/x86_64-linux-gnu/c++/11/bits/c++config.h	2026-04-29 12:18:54.619891212 +0000
@@ -2142,3 +2142,13 @@
 #endif
 
 #endif // _GLIBCXX_CXX_CONFIG_H
+
+#ifdef __CUDACC__
+#if _GLIBCXX_HAVE_BUILTIN_IS_CONSTANT_EVALUATED
+#undef _GLIBCXX_HAVE_BUILTIN_IS_CONSTANT_EVALUATED
+// Forcing __builtin_is_constant_evaluated() to always be evaluated to false,
+// so that it would have the effect like __builtin_is_constant_evaluated()
+// is not supported
+# define __builtin_is_constant_evaluated() false
+#endif
+#endif
