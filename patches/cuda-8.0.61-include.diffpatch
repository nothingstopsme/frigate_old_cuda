-   unsigned short x;
-} __half;
-
-typedef struct __align__(4) {
-   unsigned int x;
-} __half2;
-
-#ifndef CUDA_NO_HALF
-typedef __half half;
-typedef __half2 half2;
-#endif /*CUDA_NO_HALF*/
-
 #if defined(__CUDACC__)
 
 #if !defined(__cplusplus)
@@ -112,10 +99,38 @@
 
 #if defined(__CUDACC_RTC__)
 #define __CUDA_FP16_DECL__ __host__ __device__
+#define __CUDA_FP16_MEMBER_FN_DECL__ __CUDA_FP16_DECL__
 #else /* !__CUDACC_RTC__ */
 #define __CUDA_FP16_DECL__ static __device__ __inline__
+#define __CUDA_FP16_MEMBER_FN_DECL__ __device__ __inline__
 #endif /* __CUDACC_RTC__ */
 
+#endif // defined(__CUDACC__)
+
+struct __align__(2) __half {
+   unsigned short x;
+#if defined(__CUDACC__)
+   __CUDA_FP16_MEMBER_FN_DECL__ __half() = default;
+   __CUDA_FP16_MEMBER_FN_DECL__ __half(const __half&) = default;
+   __CUDA_FP16_MEMBER_FN_DECL__ __half(__half&&) = default;
+   __CUDA_FP16_MEMBER_FN_DECL__ __half& operator=(const __half&) = default;
+   __CUDA_FP16_MEMBER_FN_DECL__ __half& operator=(__half&&) = default;
+
+   __CUDA_FP16_MEMBER_FN_DECL__ __half(const float &from);
+   __CUDA_FP16_MEMBER_FN_DECL__ operator float() const;
+#endif
+};
+
+typedef struct __align__(4) {
+   unsigned int x;
+} __half2;
+
+#ifndef CUDA_NO_HALF
+typedef __half half;
+typedef __half2 half2;
+#endif /*CUDA_NO_HALF*/
+
+#if defined(__CUDACC__)
 /**
  * \ingroup CUDA_MATH__HALF_MISC
  * \brief Converts float number to half precision in round-to-nearest-even mode
@@ -126,6 +141,7 @@
  * \return Returns \p half result with converted value.
  */
 __CUDA_FP16_DECL__ __half __float2half(const float a);
+__CUDA_FP16_MEMBER_FN_DECL__ __half::__half(const float &from) : __half(__float2half(from)) { }
 /**
  * \ingroup CUDA_MATH__HALF_MISC
  * \brief Converts float number to half precision in round-towards-zero mode
@@ -165,6 +181,7 @@
  * \return Returns float result with converted value.
  */
 __CUDA_FP16_DECL__ float __half2float(const __half a);
+__CUDA_FP16_MEMBER_FN_DECL__ __half::operator float() const { return __half2float(*this); }
 
