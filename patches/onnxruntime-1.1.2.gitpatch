-
-  return __shfl_sync(mask, value, srcLane, width);
+  __shared__ volatile T cache[CUB_PTX_MAX_BLOCK_THREADS];
 
-#else
+  const int tid = cub::RowMajorTid(blockDim.x, blockDim.y, blockDim.z);
