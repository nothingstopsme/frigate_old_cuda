 std::shared_ptr<KernelRegistry> GetCudaKernelRegistry() {
+  const int cc_major = DeviceProp::GetDeviceProps().major;
+
   std::shared_ptr<KernelRegistry> kernel_registry = std::make_shared<KernelRegistry>();
   RegisterCudaKernels(*kernel_registry);
 
+  if (cc_major >= 3) {
+    // For devices with CC >= 3.0, where "3.0" is the minimal CC required by CUDNN,
+    // CUDNN-based kernels are also registered
+    RegisterCudaKernelsRequiringCUDNN(*kernel_registry);
+  }
+
 #ifndef DISABLE_CONTRIB_OPS
   ::onnxruntime::contrib::cuda::RegisterCudaContribKernels(*kernel_registry);
+
+  if (cc_major >= 3) {
+    // For devices with CC >= 3.0, where "3.0" is the minimal CC required by CUDNN,
+    // CUDNN-based kernels are also registered
+    ::onnxruntime::contrib::cuda::RegisterCudaContribKernelsRequiringCUDNN(*kernel_registry);
+  }
 #endif
 
   return kernel_registry;
