+  const int warp_id = tid >> CUB_PTX_LOG_WARP_THREADS;
+  // lane_id = tid % threads_per_warp
+  const int lane_id = tid & (CUB_PTX_WARP_THREADS-1);
+  // "width" must be a power of 2
+  const int log2_width = __ffs(width) - 1;
+  // subwarp_id = lane_id / width => one subwarp every "width" number of lanes
