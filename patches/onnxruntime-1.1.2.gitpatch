+
+#endif
 
+template <typename T>
+__device__ __forceinline__ T WARP_SHFL(T value, int srcLane, int width)
+{
+#if __CUDA_ARCH__ < 300
+  return WARP_SHFL_SHM(value, srcLane, width);
 #else
+# if CUDA_VERSION >= 9000
+  return __shfl_sync(0xffffffff, value, srcLane, width);
+# else
+  return __shfl(value, srcLane, width);
+# endif
+#endif
+}
 
+template <typename T>
+__device__ __forceinline__ T WARP_SHFL_XOR(T value, int laneMask, int width = warpSize)
