+        Status status;
+        if (!run_options)
+          status = sess->Run(*io_binding.Get());
+        else
+          status = sess->Run(*run_options, *io_binding.Get());
+        if (!status.IsOK())
+          throw std::runtime_error("Error in execution: " + status.ErrorMessage());
       });
